 //#pragma optimize ("p",on)
 /* calculation of infiltration into soil from rivers */
+
+/* port aid (#8): dump the river-flow table (flowm3s, speed, infilt_amount, infilt_fraction per index
+   0..zonmax) to $WASIM_DUMP_RFT/<tag>.f64 (appended per call), and once the processing order of the
+   river-link row (rft_order.txt: i j link zarray[link] z) and zarray. Changes nothing in the model. */
+#include <cstdlib>
+static void rft_dump(const char *tag, riverflow_table_type *t, int zonmax)
+{
+	const char *d = getenv("WASIM_DUMP_RFT");
+	if (!d || !*d || !t) return;
+	std::string fn = std::string(d) + "/" + tag + ".f64";
+	FILE *f = fopen(fn.c_str(), "ab");
+	if (!f) return;
+	for (int i = 0; i <= zonmax; i++)
+	{
+		double v[4] = { t[i].flowm3s, t[i].speed, t[i].infilt_amount, t[i].infilt_fraction };
+		fwrite(v, sizeof(double), 4, f);
+	}
+	fclose(f);
+}
